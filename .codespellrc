[codespell]
# The integration has German comments/strings + intentional English variants
# (re-use, browseable, pre-emptive). Skip generated/minified/translation files
# and allow-list the German words + valid variants so codespell only flags real typos.
skip = ./.git,*.json,*.min.js,www,build,node_modules,package-lock.json,htmlcov,.venv,.venv-tests,captures,credentials,test-results,playwright-report,*.lock,*.svg
# cros = ChromeOS user-agent token (os-detection regex); hav = Bosch
# protocol_support URL query param (client=haV<version>) — both real strings.
ignore-words-list = hass,als,browseable,checkin,explizit,ist,lokal,lokales,oder,passt,pre-emptive,pre-emptively,re-use,re-uses,sie,tage,ue,unparseable,uptodate,vor,wenn,alle,unter,titel,segmente,beginn,ende,wenns,statt,manuell,attribut,februar,cros,hav
